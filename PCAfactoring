import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.decomposition import PCA
from sklearn.preprocessing import StandardScaler
from sklearn.datasets import load_iris

iris = load_iris()
X = iris.data  # Variables numéricas
y = iris.target  # Clases (tipo de flor)

#Normalizo los datos PCA a datos normalizados, suele funcional mejor
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

#reduzco componentes
pca = PCA(n_components=2)
X_pca = pca.fit_transform(X_scaled)

df_pca = pd.DataFrame(X_pca, columns=['PC1', 'PC2'])
df_pca['Clase'] = y  # Agregamos etiquetas de clase

plt.figure(figsize=(8, 6))
colors = ['red', 'blue', 'green']
labels = iris.target_names

for i in range(3):
    subset = df_pca[df_pca['Clase'] == i]
    plt.scatter(subset['PC1'], subset['PC2'], label=labels[i], color=colors[i])

plt.xlabel('Componente Principal 1')
plt.ylabel('Componente Principal 2')
plt.title('PCA en Dataset de Iris')
plt.legend()
plt.grid()
plt.show()


